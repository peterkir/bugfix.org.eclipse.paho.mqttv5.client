-buildpath: org.eclipse.paho.mqttv5.client;version='1.2'

-includeresource: @${repo;org.eclipse.paho.mqttv5.client;1.2.5;EXACT}!/!(META-INF/MANIFEST.MF)

Bundle-Version: 	1.2.5.99_${tstamp;yyyyMMdd-HHmmss}
Bundle-Description: "Bugfix version with correct OSGi exports"
Bundle-Provider: 	Kirschners GmbH & Eclipse Foundation
Bundle-Developers:	peter@klib.io;name='Peter Kirschner';organization='Kirschners GmbH';organizationUrl='http://klib.io';roles='DevOp';timezone='Europe/Berlin'
SPDX-License-Identifier: EPL-2.0
Bundle-License:     "${SPDX-License-Identifier}";\
                    description="This program and the accompanying materials are made available under the terms of the Eclipse Public License 2.0.";\
                    link="https://spdx.org/licenses/EPL-2.0.html"
Bundle-SCM:         url=https://github.com/peterkir/bugfix.org.eclipse.paho.mqttv5.client.git,\
                    connection=scm:git:https://github.com/peterkir/bugfix.org.eclipse.paho.mqttv5.client.git,\
                    developerConnection=scm:git:git@github.com:peterkir/bugfix.org.eclipse.paho.mqttv5.client.git,\
                    git-sha=${git-sha}

paho_package_export=1.2.5

Import-Package: \
	javax.net*;resolution:=optional

Export-Package: \
	!org.eclipse.paho.mqttv5.client.internal*,\
	org.eclipse.paho.mqttv5.client*;version="${paho_package_export}",\
	!org.eclipse.paho.mqttv5.common.nls,\
	org.eclipse.paho.mqttv5.common*;version="${paho_package_export}"
