
# configure different output dirs for eclipse and gradle
target-dir: generated${if;${driver;eclipse};;/${driver}}
bin: ${if;${driver;eclipse};bin;generated/${driver}/bin}
testbin: ${if;${driver;eclipse};bin_test;generated/${driver}/bin_test}


# configure java

javac.source: 17
javac.target: 17
-noimportjava: true

# configure git

git-descriptor: ${system-allow-fail;git describe --dirty --always --abbrev=9}
git-sha:        ${system-allow-fail;git rev-list -1 --no-abbrev-commit HEAD}

# configure maven

# Maven groupId – defaults to Bundle-SymbolicName for artifactId
-groupid:   io.klib.wrap

# Maven POM version mapping:
#   - If -snapshot is set: <major>.<minor>.<micro>-<snapshot> (e.g. 7.3.0-RC1)
#   - If -snapshot is unset: <major>.<minor>.<micro>.<qualifier> (e.g. 7.3.0.202601011200)
-pom: version=${if;${def;-snapshot};${versionmask;===;${@version}}-${def;-snapshot};${versionmask;===s;${@version}}}

# Maven release configuration: generates POM, javadoc, and GPG signatures
# GPG signing is only active when GPG_KEY_ID and GPG_PASSPHRASE are set
-maven-release: sign;keyname=${env;GPG_KEY_ID};passphrase=${env;GPG_PASSPHRASE}

